{
  "name": "@clapp/utils",
  "version": "0.0.4",
  "type": "module",
  "description": "TypeScript CLI library with Commander and plugin system",
  "license": "MIT",
  "author": "Paul Glazkow",
  "exports": {
    ".": {
      "default": "./dist/clapp-utils.js",
      "types": "./dist/clapp-utils.d.ts"
    }
  },
  "keywords": [
    "cli",
    "typescript",
    "commander",
    "plugin-system",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/orion76/clapp.git",
    "directory": "packages/clapp-utils"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && cp src/json-ast/json-ast.pegjs dist/json-ast.pegjs",
    "clean": "rm -rf dist",
    "pack": "npm pack",
    "prepublishOnly": "npm run build",
    "test": "echo tests for clapp utils!",
    "test:jest": "jest",
    "install-libs": "./scripts/install.sh"
  },
  "peerDependencies": {
    "@orion76/logger": "^0.0.2"
  },
  "dependencies": {
    "asty-astq": "1.14.1",
    "jsonc-parser": "^3.3.1",
    "object-path": "^0.11.8",
    "pegjs-otf": "2.1.0",
    "pegjs-util": "2.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.2.0",
    "rollup": "^4.57.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
